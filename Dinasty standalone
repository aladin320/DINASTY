    var(--bg-raised);

  border: 1px solid var(--line);
  border-radius: 18px;

  padding: 36px;

  box-shadow:
    0 40px 100px rgba(0, 0, 0, 0.7);

  animation: docsIn .2s ease;
}


@keyframes docsIn {

  from {
    opacity: 0;
    transform: translateY(12px) scale(.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

}


/* Header */

.docs-header {
  display: flex;
  justify-content: space-between;
  gap: 30px;

  padding-bottom: 30px;

  border-bottom: 1px solid var(--line);
}


.docs-eyebrow {
  margin-bottom: 8px;

  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .12em;

  color: var(--sage);
}


.docs-title {
  font-family: var(--font-display);

  font-size: clamp(30px, 4vw, 46px);

  line-height: 1.05;

  margin-bottom: 12px;
