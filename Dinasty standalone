// ---------- Like button ----------
const likeBtn = document.getElementById('likeBtn');
const likeCount = document.getElementById('likeCount');
let liked = false;
const baseLikes = parseInt(likeCount.textContent, 10);

likeBtn.addEventListener('click', () => {
  liked = !liked;
  likeBtn.classList.toggle('liked', liked);
  likeCount.textContent = liked ? baseLikes + 1 : baseLikes;
});

// ---------- Comments (hero engagement bar) ----------
const postCommentBtn = document.getElementById('postCommentBtn');
const commentInput = document.getElementById('commentInput');
const commentList = document.getElementById('commentList');
const commentCount = document.getElementById('commentCount');

function updateCommentCount() {
  const count = commentList.querySelectorAll('.comment').length;
  commentCount.textContent = `${count} comment${count === 1 ? '' : 's'}`;
}

postCommentBtn.addEventListener('click', () => {
  const text = commentInput.value.trim();
  if (!text) return;
  const item = document.createElement('div');
  item.className = 'comment';
  item.innerHTML = `
    <div class="avatar">YO</div>
    <div class="comment-body">
      <div class="comment-top">
        <span class="comment-author">You</span>
        <span class="comment-time">just now</span>
      </div>
      <p class="comment-text"></p>
    </div>`;
  item.querySelector('.comment-text').textContent = text;
  commentList.prepend(item);
  commentInput.value = '';
  updateCommentCount();
});

