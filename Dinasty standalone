}


/* Detail page */

.docs-detail {
  display: none;

  margin-top: 28px;
}


.docs-detail.open {
  display: block;
}


.docs-grid.hidden,
.docs-popular.hidden {
  display: none;
}


.docs-back {
  background: none;

