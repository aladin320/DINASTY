                  <line x1="100" y1="234" x2="248" y2="352" stroke="url(#robotGrad)" stroke-width="32" stroke-linecap="round"/>
                  <line x1="260" y1="234" x2="112" y2="352" stroke="url(#robotGrad)" stroke-width="32" stroke-linecap="round"/>
                </g>
                <g class="robot-head">
                  <rect x="163" y="188" width="34" height="22" rx="6" fill="url(#robotGrad)"/>
