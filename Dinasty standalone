  border: 1px solid var(--line);

  background: transparent;

  color: var(--ink-dim);

  font-size: 25px;

  display: flex;
  align-items: center;
  justify-content: center;

  transition: .2s;
}


.docs-close:hover {
  color: var(--ink);

  border-color: var(--sage);

  background: rgba(143, 191, 163, .08);
}


/* Documentation cards */

.docs-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 16px;

  margin-top: 28px;
}


.docs-card {
  display: flex;

  gap: 18px;

  text-align: left;

  padding: 24px;

  background: var(--bg);

  border: 1px solid var(--line);

  border-radius: 14px;

  color: var(--ink);

