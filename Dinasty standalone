/* ---------- AI AGENT (onboarding chat) ---------- */
.agent-trigger{ display: flex; align-items: center; gap: 7px; }
.agent-trigger-dot{
  width: 7px; height: 7px; border-radius: 50%;
  background: #0F1513;
  box-shadow: 0 0 0 0 rgba(15,21,19,0.5);
