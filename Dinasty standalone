.docs-content-section p {
  color: var(--ink-dim);

  font-size: 13.5px;

  line-height: 1.65;
}


.docs-content-list {
  margin-top: 12px;

  display: grid;

  gap: 8px;
}


.docs-content-list span {
  color: var(--ink-dim);

  font-size: 13px;
}


.docs-content-list span::before {
  content: "→";

  color: var(--sage);

  margin-right: 8px;
}


/* Mobile */

@media (max-width: 700px) {

  .docs-panel {
    padding: 24px;

    max-height: 94vh;
