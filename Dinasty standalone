}

.agent-panel{ max-width: 420px; padding: 24px; display: flex; flex-direction: column; height: min(600px, 80vh); }

.agent-header{ display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-shrink: 0; }
.agent-mark{ width: 38px; height: 38px; font-size: 15px; background: var(--sage); }
.agent-title{ margin: 0; font-family: var(--font-display); font-size: 16px; color: var(--ink); }
.agent-status{ margin: 2px 0 0; font-size: 12px; color: var(--ink-faint); display: flex; align-items: center; gap: 6px; }
.agent-status-dot{ position: static; width: 7px; height: 7px; margin-left: 0; }

.agent-messages{
  flex: 1;
