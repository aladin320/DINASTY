}
.agent-msg.typing span:nth-child(2){ animation-delay: .15s; }
.agent-msg.typing span:nth-child(3){ animation-delay: .3s; }
@keyframes agentTyping{
  0%, 60%, 100%{ transform: translateY(0); opacity: .5; }
  30%{ transform: translateY(-4px); opacity: 1; }
}

.agent-quick-replies{
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
  flex-shrink: 0;
}
.quick-reply-btn{
  background: var(--panel-2);
  border: 1px solid var(--sage-dim);
  color: var(--sage);
  font-size: 12.5px;
  font-weight: 500;
  padding: 7px 14px;
  border-radius: 999px;
  transition: background .15s ease, transform .15s ease;
}
.quick-reply-btn:hover{ background: rgba(143,191,163,0.1); transform: translateY(-1px); }
.quick-reply-btn.action{
  background: var(--sage);
  color: #0F1513;
  border-color: var(--sage);
}

.agent-input-row{ display: flex; gap: 8px; flex-shrink: 0; }
.agent-input{
  flex: 1;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 10px;
