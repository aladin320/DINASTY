<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI changing Software Development</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0F1513;
  --bg-raised:#151D1A;
  --line:#26332F;
  --ink:#EDEEE7;
  --ink-dim:#9BAAA4;
  --ink-faint:#68766F;
  --sage:#8FBFA3;
  --sage-dim:#5C7C6C;
  --amber:#E7B978;

  /* Aliases so shared components (modal, quote CTA, category cards)
     inherit this theme's palette instead of falling back to defaults */
  --green: var(--sage);
  --green-dim: var(--sage-dim);
  --panel: var(--bg-raised);
  --panel-2: #1B2622;
  --muted: var(--ink-dim);
  --gray: var(--ink);
  --font-display: 'Space Grotesk', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --font-body: 'Inter', sans-serif;
}

*{ box-sizing:border-box; margin:0; padding:0; }
html{ color-scheme: dark; }
body{
  background: radial-gradient(ellipse at 15% -10%, #1B2622 0%, var(--bg) 45%) var(--bg);
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; cursor:pointer; }
::selection{ background: var(--sage); color: #0F1513; }

/* ---------- NAVBAR ---------- */
.navbar{
  position: sticky; top:0; z-index: 50;
  display:flex; align-items:center; justify-content:space-between;
  padding: 18px clamp(20px, 5vw, 64px);
  background: rgba(15,21,19,0.82);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.logo{ display:flex; align-items:center; gap:10px; }
.logo-mark{
  width:30px; height:30px; border-radius:8px;
  background: linear-gradient(155deg, var(--sage) 0%, #3E5A4C 100%);
  display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono', monospace; font-weight:600; font-size:13px;
  color:#0F1513;
  box-shadow: 0 0 0 1px rgba(143,191,163,0.25), 0 6px 16px -6px rgba(143,191,163,0.55);
  flex-shrink:0;
}
.logo-title{
  font-family:'Space Grotesk', sans-serif;
  font-style: italic;
  font-weight: 700;
  font-size: 21px;
  letter-spacing: 0.5px;
  color: var(--ink);
}
.logo-title span{ color: var(--sage); }

.nav-links{
  display:flex; align-items:center; gap:32px;
  list-style:none;
  font-size: 14px; font-weight:500; color: var(--ink-dim);
}
.nav-links a{ position:relative; transition: color .2s ease; }
.nav-links a:hover{ color: var(--ink); }
.nav-links a::after{
  content:''; position:absolute; left:0; bottom:-6px; width:0; height:1px;
  background: var(--sage); transition: width .2s ease;
}
.nav-links a:hover::after{ width:100%; }

.nav-actions{ display:flex; align-items:center; gap:14px; }
.btn-ghost{
  background:none; border:1px solid var(--line); color: var(--ink-dim);
  padding: 9px 18px; border-radius: 7px; font-size: 13.5px; font-weight:500;
  transition: all .2s ease;
}
.btn-ghost:hover{ color: var(--ink); border-color: var(--sage-dim); }
.btn-solid{
  background: var(--sage); color:#0F1513; border:none;
  padding: 9px 18px; border-radius: 7px; font-size: 13.5px; font-weight:600;
  transition: transform .15s ease, box-shadow .2s ease;
  box-shadow: 0 4px 14px -4px rgba(143,191,163,0.45);
}
.btn-solid:hover{ transform: translateY(-1px); box-shadow: 0 8px 20px -6px rgba(143,191,163,0.6); }
.btn-solid:disabled{ opacity:.4; cursor:not-allowed; transform:none; }

/* ---------- STAGE / HERO ---------- */
.stage{
  display:flex; justify-content:center;
  padding: clamp(28px, 5vw, 56px) clamp(16px, 5vw, 40px) 20px;
}
.eyebrow{ display:flex; justify-content:center; margin-bottom: 18px; }
.eyebrow span{
  font-family:'JetBrains Mono', monospace;
  font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--sage);
  border: 1px solid var(--sage-dim);
  background: rgba(143,191,163,0.07);
  padding: 6px 14px; border-radius: 999px;
}

.device-wrap{ display:flex; justify-content:center; }
.device{
  width: min(1120px, 100%);
  border-radius: 18px;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  box-shadow: 0 40px 80px -30px rgba(0,0,0,0.6);
  overflow: hidden;
}
.device-bar{
  display:flex; align-items:center; gap:8px;
  padding: 13px 18px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, #182420, #141C19);
}
.device-dot{ width:10px; height:10px; border-radius:50%; background:#3A4842; }
.device-dot:nth-child(1){ background:#E17B6B; }
.device-dot:nth-child(2){ background:#E3C36B; }
.device-dot:nth-child(3){ background:#8FBFA3; }
.device-path{
  margin-left: 14px;
  font-family:'JetBrains Mono', monospace; font-size:12px; color: var(--ink-faint);
}

.screen{
  position: relative;
  display:grid; grid-template-columns: 1.1fr 0.9fr;
  align-items:center; gap: 20px;
  padding: clamp(28px, 5vw, 56px);
  overflow:hidden;
}
.screen-grain{
  position:absolute; inset:0; pointer-events:none; opacity:0.05;
  background-image: repeating-linear-gradient(0deg, #fff 0 1px, transparent 1px 3px);
  mix-blend-mode: overlay;
}

.content-left{ position:relative; z-index:1; }
.headline{
  font-family:'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: clamp(32px, 4.2vw, 52px);
  line-height: 1.06;
  letter-spacing: -0.01em;
  margin-bottom: 18px;
}
.headline .green{ color: var(--sage); }
.headline .gray{ color: var(--ink); }

.subtext{
  color: var(--ink-dim);
  font-size: 16px; line-height: 1.65;
  max-width: 46ch;
  margin-bottom: 30px;
}

.mini-stats{
  display:flex; gap: 30px;
  padding-top: 22px;
  border-top: 1px solid var(--line);
}
.mini-stats div{ display:flex; flex-direction:column; gap:3px; }
.mini-stats strong{
  font-family:'JetBrains Mono', monospace;
  font-size: 21px; font-weight:600; color: var(--amber);
}
.mini-stats span{ font-size: 12.5px; color: var(--ink-faint); }

.content-right{ position:relative; z-index:1; }
.image-frame{ position: relative; border-radius: 14px; overflow: visible; }
.image-frame img{
  width:100%; height: 320px; object-fit: cover;
  border-radius: 14px;
  border: 1px solid var(--line);
  filter: saturate(0.9) contrast(1.02);
  display:block;
}
.profile-card{
  position:absolute; left: -18px; bottom: -22px;
  display:flex; align-items:center; gap:10px;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px 16px 10px 10px;
  box-shadow: 0 20px 40px -18px rgba(0,0,0,0.6);
}
.avatar{
  width: 36px; height: 36px; border-radius: 9px;
  background: linear-gradient(155deg, var(--sage), #3E5A4C);
  display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono', monospace; font-weight:600; font-size:13px;
  color:#0F1513;
}
.profile-meta .name{ font-size: 13.5px; font-weight:600; color: var(--ink); }
.profile-meta .role{ font-size: 11.5px; color: var(--ink-faint); }
.pulse-dot{
  width:8px; height:8px; border-radius:50%;
  background: var(--sage);
  box-shadow: 0 0 0 0 rgba(143,191,163,0.6);
  animation: pulse 2.2s infinite;
  margin-left: 4px;
}
@keyframes pulse{
  0%{ box-shadow: 0 0 0 0 rgba(143,191,163,0.55); }
  70%{ box-shadow: 0 0 0 9px rgba(143,191,163,0); }
  100%{ box-shadow: 0 0 0 0 rgba(143,191,163,0); }
}

/* ---------- HERO ROBOT (ambient background figure) ----------
   Sits behind .screen-grain and all hero content: it's the first
   child of .screen so it paints first, and it carries no positive
   z-index while every content layer above it does (.screen-grain
   isn't explicitly stacked either, so DOM order alone keeps this
   behind it; .content-left/.content-right use z-index:1 which
   always wins over an unstacked/auto layer regardless of order).
   The whole layer — svg, glow, particles, scanline — is
   pointer-events:none so it can never intercept clicks/taps. */
.hero-robot-wrap{
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.hero-robot-glow{
  position: absolute;
  width: 68%;
  aspect-ratio: 1;
  left: -6%;
  top: 8%;
  background: radial-gradient(circle at 58% 32%, rgba(139,124,246,0.35), rgba(92,200,224,0.16) 45%, transparent 72%);
  filter: blur(46px);
}

.hero-robot{
  position: relative;
  width: min(560px, 60%);
  max-width: 620px;
  height: auto;
  opacity: 0.55;
  filter:
    drop-shadow(0 0 26px rgba(139,124,246,0.35))
    drop-shadow(0 0 54px rgba(92,200,224,0.2));
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 55%, rgba(0,0,0,0) 94%);
          mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 55%, rgba(0,0,0,0) 94%);
  margin-left: -4%;
}

.robot-bloom{ opacity: 0.6; }
.robot-crisp{ opacity: 0.85; }

/* Head is its own group so it can tilt independently of the body —
   this is exactly what a single flattened image couldn't do. */
.robot-head{
  transform-box: view-box;
  transform-origin: 180px 192px;
  animation: robotLook 8s ease-in-out infinite;
}

/* Torso + crossed arms move together as one static "arms crossed"
   pose, with only a slow breathing scale for a sense of life. */
.robot-torso{
  transform-box: view-box;
  transform-origin: 180px 300px;
  animation: robotBreathe 6s ease-in-out infinite;
}

@keyframes robotLook{
  0%   { transform: rotate(-4deg); }
  30%  { transform: rotate(3deg); }
  55%  { transform: rotate(5deg); }
  80%  { transform: rotate(-2deg); }
  100% { transform: rotate(-4deg); }
}

@keyframes robotBreathe{
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.015); }
}

.hero-scanline{
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(139,124,246,0.14) 48%, transparent 52%);
  mix-blend-mode: screen;
  animation: scanSweep 5.5s linear infinite;
}

@keyframes scanSweep{
  0%   { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

.hero-particles{ position: absolute; inset: 0; }
.particle{
  position: absolute;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(143,191,163,0.95), rgba(143,191,163,0) 70%);
  opacity: 0;
  animation: particleFloat 6s ease-in infinite;
}
.particle:nth-child(1){ left: 42%; top: 70%; animation-delay: 0s; }
.particle:nth-child(2){ left: 34%; top: 55%; animation-delay: 1.1s; background: radial-gradient(circle, rgba(139,124,246,0.95), transparent 70%); }
.particle:nth-child(3){ left: 26%; top: 75%; animation-delay: 2.3s; }
.particle:nth-child(4){ left: 38%; top: 40%; animation-delay: 3.1s; background: radial-gradient(circle, rgba(92,200,224,0.95), transparent 70%); }
.particle:nth-child(5){ left: 20%; top: 60%; animation-delay: 0.6s; }
.particle:nth-child(6){ left: 30%; top: 30%; animation-delay: 2.8s; background: radial-gradient(circle, rgba(139,124,246,0.9), transparent 70%); }

@keyframes particleFloat{
  0%   { transform: translateY(0) scale(1); opacity: 0; }
  10%  { opacity: 0.9; }
  50%  { transform: translateY(-40px) scale(1.15); opacity: 0.7; }
  90%  { opacity: 0; }
  100% { transform: translateY(-90px) scale(0.8); opacity: 0; }
}

/* ---------- ENGAGEMENT BAR (like + comments) ---------- */
.engage-wrap{ display:flex; justify-content:center; padding: 0 clamp(16px, 5vw, 40px) 60px; }
.engage{ width: min(1120px, 100%); }
.engage-bar{
  display:flex; align-items:center; gap: 14px;
  padding: 16px clamp(20px, 4vw, 32px);
  border: 1px solid var(--line);
  border-top: none;
  background: var(--bg-raised);
  border-bottom-left-radius: 18px;
  border-bottom-right-radius: 18px;
}
.like-btn{
  display:flex; align-items:center; gap:8px;
  background: none; border: 1px solid var(--line);
  color: var(--ink-dim);
  padding: 8px 16px; border-radius: 999px;
  font-size: 13.5px; font-weight:500;
  transition: all .18s ease;
}
.like-btn svg{ width:16px; height:16px; transition: transform .18s ease; }
.like-btn.liked{ color: #0F1513; background: var(--sage); border-color: var(--sage); }
.like-btn.liked svg{ transform: scale(1.15); }
.like-btn:active svg{ transform: scale(0.85); }

.comment-count{ font-size: 13.5px; color: var(--ink-faint); font-family:'JetBrains Mono', monospace; }

.comment-section{ padding: 26px clamp(20px, 4vw, 32px) 6px; }
.comment-heading{
  font-family:'Space Grotesk', sans-serif;
  font-size: 17px; font-weight:600; margin-bottom: 16px;
  color: var(--ink);
}
.comment-form{ display:flex; gap: 12px; margin-bottom: 26px; }
.comment-form .avatar{ flex-shrink:0; }
.comment-input-wrap{ flex:1; }
.comment-input{
  width:100%; resize: vertical; min-height: 46px;
  background: var(--bg);
  border: 1px solid var(--line);
  color: var(--ink);
  border-radius: 10px;
  padding: 12px 14px;
  font-family: 'Inter', sans-serif; font-size: 14px;
  line-height: 1.5;
}
.comment-input:focus{
  outline: none; border-color: var(--sage-dim);
  box-shadow: 0 0 0 3px rgba(143,191,163,0.12);
}
.comment-form-actions{ display:flex; justify-content:flex-end; margin-top: 8px; }
.comment-list{ display:flex; flex-direction:column; gap: 20px; padding-bottom: 24px; }
.comment{ display:flex; gap: 12px; }
.comment-body{ flex:1; }
.comment-top{ display:flex; align-items:baseline; gap:10px; margin-bottom: 4px; }
.comment-author{ font-size: 13.5px; font-weight:600; color: var(--ink); }
.comment-time{ font-size: 12px; color: var(--ink-faint); }
.comment-text{ font-size: 13.5px; color: var(--ink-dim); line-height:1.55; }

/* ---------- HOME / CATEGORIES ---------- */
.categories-wrap{ display:flex; justify-content:center; padding: 20px clamp(16px, 5vw, 40px) 70px; }
.categories{ max-width: 1120px; width: 100%; text-align:center; }
.categories-eyebrow{
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--sage);
  margin: 0 0 10px;
}
.categories-title{
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 32px);
  margin: 0 0 10px;
}
.categories-subtext{
  color: var(--ink-dim);
  font-size: 15px;
  max-width: 480px;
  margin: 0 auto 32px;
}
.category-grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}
.category-card{
  display:flex; flex-direction:column; align-items:center; gap:10px;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px 12px;
  transition: border-color .15s ease, transform .15s ease, background .15s ease;
}
.category-card:hover{
  border-color: var(--sage-dim);
  transform: translateY(-2px);
  background: var(--panel-2);
}
.cat-emoji{ font-size: 26px; }
.cat-label{ font-size: 13px; font-weight:600; color: var(--ink); }

/* ---------- PRODUCT ---------- */
.product-wrap{ display:flex; justify-content:center; padding: 20px clamp(16px, 5vw, 40px) 80px; }
.product{ max-width: 1120px; width: 100%; text-align:center; }
.product-eyebrow{
  font-family: var(--font-mono);
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--sage);
  margin: 0 0 10px;
}
.product-title{
  font-family: var(--font-display);
  font-size: clamp(26px, 3.6vw, 40px);
  line-height: 1.15;
  margin: 0 0 14px;
}
.product-subtext{
  color: var(--ink-dim);
  font-size: 15.5px;
  line-height: 1.6;
  max-width: 56ch;
  margin: 0 auto 44px;
}

.product-grid{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 40px;
  text-align: left;
}
.product-feature{
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px 20px;
  transition: border-color .15s ease, transform .15s ease;
}
.product-feature:hover{ border-color: var(--sage-dim); transform: translateY(-2px); }
.feature-icon{ font-size: 24px; display:block; margin-bottom: 12px; }
.product-feature h3{
  font-family: var(--font-display);
  font-size: 15.5px;
  font-weight: 600;
  color: var(--ink);
  margin: 0 0 8px;
}
.product-feature p{
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--ink-dim);
  margin: 0;
}

.product-cta{ display:flex; justify-content:center; gap: 14px; }

@media (max-width: 860px){
  .product-grid{ grid-template-columns: 1fr 1fr; }
  .product-cta{ flex-direction: column; align-items: center; }
}

/* ---------- MODALS (sign-in + quote) ---------- */
.modal-overlay{
  position: fixed;
  inset: 0;
  background: rgba(5,7,5,0.7);
  backdrop-filter: blur(4px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 100;
}
.modal-overlay.open{ display: flex; }

.modal-panel{
  position: relative;
  width: 100%;
  max-width: 460px;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 32px;
  box-shadow: 0 40px 90px -30px rgba(0,0,0,0.8);
  animation: modalIn .18s ease;
}
@keyframes modalIn{
  from{ opacity: 0; transform: translateY(8px) scale(.98); }
  to{ opacity: 1; transform: translateY(0) scale(1); }
}

.modal-close{
  position: absolute;
  top: 18px; right: 18px;
  width: 30px; height: 30px;
  border-radius: 50%;
  background: transparent;
  border: 1px solid var(--line);
  color: var(--muted);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
}
.modal-close:hover{ color: var(--gray); border-color: var(--muted); }
.modal-close svg{ width: 14px; height: 14px; }

.modal-eyebrow{
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--green);
  margin: 0 0 8px;
}
.modal-title{
  font-family: var(--font-display);
  font-size: 26px;
  margin: 0 0 8px;
}
.modal-subtext{
  color: var(--muted);
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 24px;
}

/* AI search + grid (sign-in modal) */
.ai-search{
  width: 100%;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--gray);
  padding: 10px 12px;
  font-family: var(--font-body);
  font-size: 13px;
  margin-bottom: 14px;
}
.ai-search:focus{ outline: none; border-color: var(--green-dim); }
.ai-search::placeholder{ color: var(--muted); }
.ai-search.hidden-view{ display: none; }

.ai-grid{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 24px;
  max-height: 320px;
  overflow-y: auto;
  padding-right: 4px;
}
.ai-grid::-webkit-scrollbar{ width: 6px; }
.ai-grid::-webkit-scrollbar-thumb{ background: var(--line); border-radius: 3px; }
.ai-grid.hidden-view{ display: none; }

.ai-option{
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px;
  cursor: pointer;
  text-align: left;
  transition: border-color .15s ease, background .15s ease;
}
.ai-option:hover{ border-color: var(--muted); }
.ai-option.hidden{ display: none; }

.ai-mark{
  width: 30px; height: 30px;
  border-radius: 8px;
  background: var(--c, var(--green));
  color: #06170a;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 13px;
  flex-shrink: 0;
}
.ai-info{ display: flex; flex-direction: column; min-width: 0; }
.ai-name{ font-size: 13px; font-weight: 600; }
.ai-vendor{ font-size: 11px; color: var(--muted); }

.modal-continue{ width: 100%; padding: 12px; font-size: 14px; }

/* Detail view (shown after picking one AI) */
.ai-detail{ display: none; }
.ai-detail.open{ display: block; }

.detail-back{
  background: none;
  border: none;
  color: var(--muted);
  font-size: 13px;
  cursor: pointer;
  padding: 0;
  margin-bottom: 18px;
}
