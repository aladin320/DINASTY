{
  "name": "dinasty-site",
  "version": "1.0.0",
  "description": "DINASTY — goal-based AI tool discovery site, with an Express + SQLite backend.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "npx -y -p node@20 node server.js",
    "dev": "npx -y -p node@20 node --watch server.js",
    "test": "npx -y -p node@20 node --test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "prettier": "^3.4.2"
  }
}
